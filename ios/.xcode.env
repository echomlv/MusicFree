# Select the project Node version even when Xcode starts outside an nvm shell.
MUSICFREE_NODE_VERSION="$(tr -d '[:space:]' < "$(dirname "${BASH_SOURCE[0]}")/../.nvmrc")"
MUSICFREE_NVM_NODE="${NVM_DIR:-$HOME/.nvm}/versions/node/v${MUSICFREE_NODE_VERSION#v}/bin/node"

if [ -x "$MUSICFREE_NVM_NODE" ]; then
  export NODE_BINARY="$MUSICFREE_NVM_NODE"
else
  # CI may provide the pinned version directly through PATH.
  export NODE_BINARY="$(command -v node)"
fi

if [ -z "$NODE_BINARY" ] || [ "$("$NODE_BINARY" --version)" != "v${MUSICFREE_NODE_VERSION#v}" ]; then
  echo "error: Xcode requires Node $MUSICFREE_NODE_VERSION from .nvmrc. Run nvm install in the project directory." >&2
  return 1
fi

export PATH="$(dirname "$NODE_BINARY"):$PATH"
